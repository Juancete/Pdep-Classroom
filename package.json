{
  "name": "pdep-classroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migration:up && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:migrations": "vitest run --config vitest.migrations.config.ts",
    "test:coverage": "vitest run --coverage",
    "db:migration:create": "mikro-orm migration:create",
    "db:migration:up": "mikro-orm migration:up",
    "db:migration:down": "mikro-orm migration:down",
    "db:schema:fresh": "mikro-orm schema:fresh --run"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@mikro-orm/cli": "^6.6.12",
    "@mikro-orm/core": "^6.6.12",
    "@mikro-orm/migrations": "^6.6.12",
    "@mikro-orm/postgresql": "^6.6.12",
    "@mikro-orm/reflection": "^6.6.12",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^21.0.0",
    "googleapis": "^144.0.0",
    "next": "^14.2.0",
    "next-auth": "^5.0.0-beta.25",
    "pino": "^10.3.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.24",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^29.0.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
