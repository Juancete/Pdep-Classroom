# ── Base de datos ────────────────────────────────────────────
# En local, coincide con el docker-compose.yml del repo. En producción,
# la connection string pooled de Neon.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pdep_classroom

# ── GitHub OAuth App ──────────────────────────────────────────
# Crear en https://github.com/settings/applications/new
# Homepage URL: https://tu-dominio.vercel.app
# Callback URL: https://tu-dominio.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App (para operar sobre la org pdep-mn-utn) ────────────
# Crear en https://github.com/organizations/pdep-mn-utn/settings/apps/new
# Permisos necesarios: Repository (Admin, Contents, Actions), Organization Members (Read)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # base64 del .pem
GITHUB_APP_INSTALLATION_ID=

# ── Org de GitHub ────────────────────────────────────────────
GITHUB_ORG=pdep-mn-utn

# ── Google Sheets ────────────────────────────────────────────
# Service account JSON (base64). Crear en Google Cloud Console.
# Compartir las spreadsheets con el email de la service account.
# El ID de cada spreadsheet NO va acá: es por comisión, se carga desde
# /admin/comisiones (Comision.spreadsheetId).
GOOGLE_SERVICE_ACCOUNT_KEY=    # base64 del JSON

# ── Google Group ─────────────────────────────────────────────
# Al hacer el alta de un alumno lo suscribimos automáticamente a este
# grupo. Si GOOGLE_GROUP_EMAIL está vacío, la feature queda desactivada.
#
# Requisitos de Google Workspace:
#   1) Habilitar Domain-Wide Delegation en la service account de
#      GOOGLE_SERVICE_ACCOUNT_KEY y autorizar el scope
#      https://www.googleapis.com/auth/admin.directory.group.member
#   2) Configurar GOOGLE_WORKSPACE_ADMIN_EMAIL con un usuario admin del
#      workspace — la service account lo impersona para poder agregar
#      miembros al grupo.
#
# Si seteás GOOGLE_GROUP_EMAIL sin GOOGLE_WORKSPACE_ADMIN_EMAIL, el
# server falla al arrancar (ver src/instrumentation.ts) — misconfig
# intencional para no dejar que el error le aparezca al alumno.
GOOGLE_GROUP_EMAIL=
GOOGLE_WORKSPACE_ADMIN_EMAIL=

# ── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_SECRET=               # npx auth secret

# ── Admins ───────────────────────────────────────────────────
# Usernames de GitHub de los docentes (comma-separated)
ADMIN_GITHUB_USERNAMES=Juancete,fdodino

# ── Login de desarrollo (opcional, solo local) ────────────────
# Entrar tipeando cualquier username, sin pasar por el OAuth real de GitHub.
# Requiere las DOS condiciones: NODE_ENV=development (lo pone `next dev` solo)
# Y este flag en "true". Nunca setear en producción.
ENABLE_DEV_LOGIN=
