# ── GitHub OAuth App ──────────────────────────────────────────
# Crear en https://github.com/settings/applications/new
# Homepage URL: https://tu-dominio.vercel.app
# Callback URL: https://tu-dominio.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App (para operar sobre la org pdep-mn-utn) ────────────
# Crear en https://github.com/organizations/pdep-mn-utn/settings/apps/new
# Permisos necesarios: Repository (Admin), Organization Members (Read)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # base64 del .pem
GITHUB_APP_INSTALLATION_ID=

# ── Org de GitHub ────────────────────────────────────────────
GITHUB_ORG=pdep-mn-utn

# ── Google Sheets ────────────────────────────────────────────
# Service account JSON (base64). Crear en Google Cloud Console.
# Compartir las spreadsheets con el email de la service account.
GOOGLE_SERVICE_ACCOUNT_KEY=    # base64 del JSON

# ID de las spreadsheets (el string largo en la URL)
GOOGLE_SHEET_ALUMNOS_ID=1liT_85mXJKDwWw40Vu32Gx2QBZH3m56rdFaz_RZOWvU
GOOGLE_SHEET_PLANIFICACION_ID=

# ── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=               # npx auth secret

# ── Admins ───────────────────────────────────────────────────
# Usernames de GitHub de los docentes (comma-separated)
ADMIN_GITHUB_USERNAMES=Juancete,fdodino
